# Browser-facing API base. In local dev this is the Next rewrite prefix:
#   /api/:path*  →  $API_ORIGIN/:path*
# Set this (and API_ORIGIN) to prefer the live public API. Leave both unset
# to use public/mock-data so the demo still boots without a backend.
NEXT_PUBLIC_API_URL=http://localhost:3002/api

# Real API origin used by the server and by the /api rewrite.
# Local API: http://localhost:8080
# Confirm with: curl -s http://localhost:8080/healthz
# Confirm public: curl -s http://localhost:8080/v1/public/companies
API_ORIGIN=http://localhost:8080

NEXT_PUBLIC_APP_URL=http://localhost:3002
NEXT_PUBLIC_MARKETPLACE_DOMAIN=benwer.es
NEXT_PUBLIC_ENV=local
