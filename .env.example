# API origin ONLY — no /v1 (and no trailing slash).
# openapi-fetch concatenates baseUrl + "/v1/public/...", so this:
#   NEXT_PUBLIC_API_URL=https://cars-api.benwer.es/v1
# becomes GET https://cars-api.benwer.es/v1/v1/public/companies (404)
# and the client used to fall back to mock cars (wrong images / v-med-1 ids).
#
# Right:
#   Local API:     http://localhost:8080
#   Production:    https://cars-api.benwer.es
# Same-origin BFF (optional): http://localhost:3002/api
# Confirm: curl -s "$NEXT_PUBLIC_API_URL/v1/public/companies"
NEXT_PUBLIC_API_URL=http://localhost:8080

# Server-side origin (Server Components + /api BFF). Same rule: no /v1 suffix.
# Local API: http://localhost:8080
# Production: https://cars-api.benwer.es
# Confirm with: curl -s http://localhost:8080/healthz
# Confirm public: curl -s http://localhost:8080/v1/public/companies
API_ORIGIN=http://localhost:8080

# LocalStack S3 (seed photos). Marketplace rewrites /localstack/:path* here.
LOCALSTACK_ORIGIN=http://localhost:4566

# Optional public CDN/S3 origin used to turn bare object keys into image
# URLs. When unset, keys without http(s) stay empty and the UI shows the
# photo empty-state (never a mock Corolla/SUV/Tesla jpg).
# NEXT_PUBLIC_MEDIA_ORIGIN=https://dxxxx.cloudfront.net

NEXT_PUBLIC_APP_URL=http://localhost:3002
NEXT_PUBLIC_MARKETPLACE_DOMAIN=benwer.es
NEXT_PUBLIC_ENV=local

# Marketing / plans checkout (landing page). Default is the live cars site.
# Override if plans move to a dedicated path, e.g. https://cars.benwer.es/#pricing
NEXT_PUBLIC_MARKETING_URL=https://cars.benwer.es

# Optional live admin demo. When unset, the homepage partners section hides the
# secondary "View live demo" button.
# NEXT_PUBLIC_ADMIN_DEMO_URL=https://admin.cars.benwer.es
